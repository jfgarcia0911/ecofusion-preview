// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  role               String    @default("user") // "admin" | "manager" | "user"
  onboardingComplete Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  zones              Zone[]
  tasks              Task[]
  employees          Employee[]
  lmsProgress        UserLmsProgress[]
  dashboardData      DashboardData?
  schedules          Schedule[]        @relation("UserSchedules")
  assignedSchedules  Schedule[]        @relation("AssignedSchedules")
  scheduledTasks     ScheduledTask[]   @relation("AssignedTasks")
  createdTasks       ScheduledTask[]   @relation("CreatedTasks")
  notifications      Notification[]

  // Training/LMS relations
  assignedCourses    CourseAssignment[] @relation("AssignedCourses")
  coursesAssignedBy  CourseAssignment[] @relation("AssignedByCourses")
  completedCourses   CourseCompletion[] @relation("CompletedCourses")
  completedLessons   LessonCompletion[] @relation("CompletedLessons")

  // Inventory & Sales relations
  fishStocks         FishStock[]
  plantCrops         PlantCrop[]
  growthParameters   GrowthParameter[]
  harvests           Harvest[]
  salesInventory     SalesInventory[]
  sales              Sale[]
  integrationSettings IntegrationSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User-specific zones for operations monitoring
model Zone {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // "aquaculture" | "hydroponics" | "biodigestion" | "other"
  status    String   @default("active") // "active" | "maintenance" | "offline"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics SensorReading[]
  fishStocks FishStock[]
  plantCrops PlantCrop[]
}

// Sensor readings for zones
model SensorReading {
  id          String   @id @default(cuid())
  zoneId      String
  temperature Float?
  ph          Float?
  dissolvedO2 Float?
  ammonia     Float?
  humidity    Float?
  timestamp   DateTime @default(now())

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

// User tasks (personal tasks)
model Task {
  id        String   @id @default(cuid())
  userId    String
  text      String
  completed Boolean  @default(false)
  priority  String   @default("medium") // "high" | "medium" | "low"
  dueDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// User employees (for admin management)
model Employee {
  id        String   @id @default(cuid())
  userId    String
  name      String
  role      String
  email     String
  phone     String?
  status    String   @default("Active") // "Active" | "On Leave" | "Inactive"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Weekly schedule for users (created by admin)
model Schedule {
  id          String   @id @default(cuid())
  adminId     String   // Admin who created the schedule
  assigneeId  String   // User assigned to this schedule
  title       String
  description String?
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, etc.
  startTime   String   // "09:00" format
  endTime     String   // "17:00" format
  location    String?
  recurring   Boolean  @default(true)
  color       String   @default("#00FF9D") // For calendar display
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin    User @relation("UserSchedules", fields: [adminId], references: [id], onDelete: Cascade)
  assignee User @relation("AssignedSchedules", fields: [assigneeId], references: [id], onDelete: Cascade)
}

// Scheduled tasks assigned to users (created by admin)
model ScheduledTask {
  id           String    @id @default(cuid())
  creatorId    String    // Admin who created the task
  assigneeId   String    // User assigned to this task
  title        String
  description  String?
  scheduledFor DateTime  // When the task should be done
  dueDate      DateTime  // Deadline
  priority     String    @default("medium") // "high" | "medium" | "low"
  status       String    @default("pending") // "pending" | "in_progress" | "completed" | "overdue"
  zone         String?   // Optional zone association
  notifyBefore Int       @default(30) // Minutes before to notify
  notified     Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  creator  User @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee User @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Cascade)
}

// Notifications for users
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // "info" | "warning" | "task" | "schedule"
  read      Boolean  @default(false)
  link      String?  // Optional link to related content
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// LMS progress tracking (legacy - keeping for migration)
model UserLmsProgress {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  lessonId    String?
  completed   Boolean   @default(false)
  quizScore   Int?
  xpEarned    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lessonId])
}

// Compliance/Safety Training Courses (stored in DB, admin-managed)
model TrainingCourse {
  id           String   @id @default(cuid())
  code         String   @unique // e.g., "OSHA-001", "FOOD-001"
  title        String
  description  String   @db.Text
  category     String   // "safety", "compliance", "operations", "technical"
  duration     Int      // Duration in minutes
  isRequired   Boolean  @default(false) // Is this a mandatory compliance course?
  renewalDays  Int?     // Days until certification renewal required (null = no renewal)
  passScore    Int      @default(80) // Minimum passing score for quiz
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lessons      TrainingLesson[]
  assignments  CourseAssignment[]
  completions  CourseCompletion[]
}

// Lessons within a training course
model TrainingLesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  type        String   @default("text") // "text", "video", "quiz", "interactive"
  content     String?  @db.Text // Markdown content or video URL
  duration    Int      // Duration in minutes
  sortOrder   Int      @default(0)
  questions   Json?    // Quiz questions if type is "quiz"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
}

// Admin assigns courses to employees
model CourseAssignment {
  id           String    @id @default(cuid())
  courseId     String
  assigneeId   String    // User receiving the assignment
  assignedById String    // Admin who assigned it
  dueDate      DateTime? // Optional deadline
  priority     String    @default("normal") // "urgent", "high", "normal", "low"
  notes        String?   // Admin notes for the assignee
  status       String    @default("assigned") // "assigned", "in_progress", "completed", "overdue"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course     TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignee   User           @relation("AssignedCourses", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedBy User           @relation("AssignedByCourses", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([courseId, assigneeId]) // One assignment per course per user
}

// Track course completions with certification details
model CourseCompletion {
  id              String    @id @default(cuid())
  courseId        String
  userId          String
  completedAt     DateTime  @default(now())
  quizScore       Int?      // Final quiz score if applicable
  passed          Boolean   @default(true)
  certificateId   String?   @unique // Unique certificate number
  expiresAt       DateTime? // When certification expires (if renewal required)
  createdAt       DateTime  @default(now())

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User           @relation("CompletedCourses", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId]) // One completion record per course per user
}

// Track individual lesson completions
model LessonCompletion {
  id          String    @id @default(cuid())
  lessonId    String
  userId      String
  completedAt DateTime  @default(now())
  quizScore   Int?      // Score if lesson was a quiz
  timeSpent   Int?      // Time spent in seconds

  lesson TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User           @relation("CompletedLessons", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId]) // One completion per lesson per user
}

// User dashboard data (KPIs, revenue, etc.)
model DashboardData {
  id               String   @id @default(cuid())
  userId           String   @unique
  totalRevenue     Float    @default(0)
  monthlyRevenue   Float    @default(0)
  activeZones      Int      @default(0)
  systemEfficiency Float    @default(0)
  alertCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// INVENTORY & PRODUCTION MANAGEMENT
// ==========================================

// Fish stock/inventory per zone
model FishStock {
  id              String    @id @default(cuid())
  userId          String
  zoneId          String
  species         String    // e.g., "Tilapia", "Catfish", "Trout"
  quantity        Int
  avgWeight       Float?    // Average weight in grams
  ageWeeks        Int?      // Age in weeks
  dateAdded       DateTime  @default(now())
  expectedHarvest DateTime?
  status          String    @default("growing") // "growing", "ready", "harvested"
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone       Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  growthLogs FishGrowthLog[]
  harvests   Harvest[]
}

// Fish growth tracking log
model FishGrowthLog {
  id          String   @id @default(cuid())
  fishStockId String
  recordedAt  DateTime @default(now())
  avgWeight   Float    // Weight at time of recording
  mortality   Int      @default(0) // Fish lost
  feedUsed    Float?   // kg of feed
  notes       String?

  fishStock FishStock @relation(fields: [fishStockId], references: [id], onDelete: Cascade)
}

// Plant crop inventory per zone
model PlantCrop {
  id              String    @id @default(cuid())
  userId          String
  zoneId          String
  cropType        String    // e.g., "Lettuce", "Basil", "Tomatoes"
  variety         String?   // e.g., "Butterhead", "Genovese"
  quantity        Int       // Number of plants
  plantedDate     DateTime
  expectedHarvest DateTime?
  status          String    @default("growing") // "seedling", "growing", "ready", "harvested"
  location        String?   // Specific grow bed/area
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone       Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  growthLogs PlantGrowthLog[]
  harvests   Harvest[]
}

// Plant growth tracking log
model PlantGrowthLog {
  id          String   @id @default(cuid())
  plantCropId String
  recordedAt  DateTime @default(now())
  heightCm    Float?   // Average height
  healthScore Int?     // 1-10 scale
  losses      Int      @default(0) // Plants lost
  notes       String?

  plantCrop PlantCrop @relation(fields: [plantCropId], references: [id], onDelete: Cascade)
}

// Growth parameter templates for species/crop types
model GrowthParameter {
  id            String   @id @default(cuid())
  userId        String
  type          String   // "fish" or "plant"
  species       String   // e.g., "Tilapia" or "Lettuce"
  variety       String?

  // Growth timeline
  seedlingDays  Int?     // Days in seedling stage (plants)
  growingDays   Int      // Days to maturity
  harvestWeight Float?   // Expected weight at harvest (fish: grams, plants: grams)

  // Environmental parameters
  optimalTempMin Float?
  optimalTempMax Float?
  optimalPh      Float?

  // Yield expectations
  expectedYield Float?   // Expected output per unit
  yieldUnit     String?  // "kg", "heads", "bunches"

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Harvest records
model Harvest {
  id          String    @id @default(cuid())
  userId      String
  harvestDate DateTime  @default(now())
  type        String    // "fish" or "plant"
  fishStockId String?
  plantCropId String?
  quantity    Float     // Amount harvested
  unit        String    // "kg", "heads", "bunches"
  quality     String?   // "A", "B", "C" grade
  destination String    @default("inventory") // "inventory", "sale", "waste"
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fishStock FishStock? @relation(fields: [fishStockId], references: [id])
  plantCrop PlantCrop? @relation(fields: [plantCropId], references: [id])
  saleItems SaleItem[]
  salesInventory SalesInventory[]
}

// ==========================================
// SALES MANAGEMENT
// ==========================================

// Sales inventory (items ready for sale)
model SalesInventory {
  id          String    @id @default(cuid())
  userId      String
  productName String
  productType String    // "fish", "produce", "other"
  quantity    Float
  unit        String    // "kg", "heads", "bunches"
  unitPrice   Float
  harvestId   String?   // Optional link to harvest
  addedDate   DateTime  @default(now())
  expiryDate  DateTime?
  status      String    @default("available") // "available", "reserved", "sold", "expired"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  harvest   Harvest?  @relation(fields: [harvestId], references: [id])
  saleItems SaleItem[]
}

// Sales transactions
model Sale {
  id            String    @id @default(cuid())
  userId        String
  saleDate      DateTime  @default(now())
  customerName  String?
  customerEmail String?
  customerPhone String?
  subtotal      Float
  tax           Float     @default(0)
  discount      Float     @default(0)
  total         Float
  paymentMethod String?   // "cash", "card", "invoice"
  status        String    @default("completed") // "pending", "completed", "cancelled"
  notes         String?

  // CRM Integration
  crmCustomerId String?   // Satistio/GoHighLevel contact ID
  crmSynced     Boolean   @default(false)
  crmSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SaleItem[]
}

// Sale line items
model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  inventoryItemId String?
  harvestId       String?
  productName     String
  quantity        Float
  unit            String
  unitPrice       Float
  total           Float

  sale          Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem SalesInventory? @relation(fields: [inventoryItemId], references: [id])
  harvest       Harvest?        @relation(fields: [harvestId], references: [id])
}

// ==========================================
// CRM INTEGRATION SETTINGS
// ==========================================

// Integration settings for CRM (Satistio/GoHighLevel)
model IntegrationSettings {
  id         String    @id @default(cuid())
  userId     String    @unique
  provider   String    // "gohighlevel"
  apiKey     String?   // Stored encrypted
  locationId String?
  isEnabled  Boolean   @default(false)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
