generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  onboardingComplete  Boolean              @default(false)
  role                String               @default("user")
  accounts            Account[]
  alerts              Alert[]              @relation("AlertOwner")
  cameras             Camera[]
  coursesAssignedBy   CourseAssignment[]   @relation("AssignedByCourses")
  assignedCourses     CourseAssignment[]   @relation("AssignedCourses")
  completedCourses    CourseCompletion[]   @relation("CompletedCourses")
  dashboardData       DashboardData?
  employees           Employee[]
  fishStocks          FishStock[]
  growthParameters    GrowthParameter[]
  harvests            Harvest[]
  integrationSettings IntegrationSettings?
  completedLessons    LessonCompletion[]   @relation("CompletedLessons")
  notifications       Notification[]
  phaseSettings       PhaseSettings[]
  plantCrops          PlantCrop[]
  sales               Sale[]
  salesInventory      SalesInventory[]
  schedules           Schedule[]           @relation("UserSchedules")
  assignedSchedules   Schedule[]           @relation("AssignedSchedules")
  scheduledTasks      ScheduledTask[]      @relation("AssignedTasks")
  createdTasks        ScheduledTask[]      @relation("CreatedTasks")
  sessions            Session[]
  tasks               Task[]
  lmsProgress         UserLmsProgress[]
  zones               Zone[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Zone {
  id              String               @id @default(cuid())
  userId          String
  name            String
  type            String
  status          String               @default("active")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  fishStocks      FishStock[]
  plantCrops      PlantCrop[]
  metrics         SensorReading[]
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertThresholds ZoneAlertThreshold[]
  alerts          Alert[]
  cameras         Camera[]
}

model SensorReading {
  id          String   @id @default(cuid())
  zoneId      String
  temperature Float?
  ph          Float?
  dissolvedO2 Float?
  ammonia     Float?
  humidity    Float?
  timestamp   DateTime @default(now())
  zone        Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, timestamp])
}

model ZoneAlertThreshold {
  id         String   @id @default(cuid())
  zoneId     String
  parameter  String
  minValue   Float?
  maxValue   Float?
  enabled    Boolean  @default(true)
  alertLevel String   @default("warning")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  zone       Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, parameter])
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  text      String
  completed Boolean   @default(false)
  priority  String    @default("medium")
  dueDate   DateTime?
  phaseId   String?
  assignee  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Employee {
  id        String   @id @default(cuid())
  userId    String
  name      String
  role      String
  email     String
  phone     String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts    Alert[]
}

model Schedule {
  id          String   @id @default(cuid())
  adminId     String
  assigneeId  String
  title       String
  description String?
  dayOfWeek   Int
  startTime   String
  endTime     String
  location    String?
  recurring   Boolean  @default(true)
  color       String   @default("#00FF9D")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       User     @relation("UserSchedules", fields: [adminId], references: [id], onDelete: Cascade)
  assignee    User     @relation("AssignedSchedules", fields: [assigneeId], references: [id], onDelete: Cascade)
}

model ScheduledTask {
  id           String    @id @default(cuid())
  creatorId    String
  assigneeId   String
  title        String
  description  String?
  scheduledFor DateTime
  dueDate      DateTime
  priority     String    @default("medium")
  status       String    @default("pending")
  zone         String?
  notifyBefore Int       @default(30)
  notified     Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignee     User      @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator      User      @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLmsProgress {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  lessonId    String?
  completed   Boolean   @default(false)
  quizScore   Int?
  xpEarned    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lessonId])
}

model TrainingCourse {
  id          String             @id @default(cuid())
  code        String             @unique
  title       String
  description String
  category    String
  duration    Int
  isRequired  Boolean            @default(false)
  renewalDays Int?
  passScore   Int                @default(80)
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  assignments CourseAssignment[]
  completions CourseCompletion[]
  lessons     TrainingLesson[]
}

model TrainingLesson {
  id          String             @id @default(cuid())
  courseId    String
  title       String
  description String?
  type        String             @default("text")
  content     String?
  duration    Int
  sortOrder   Int                @default(0)
  questions   Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  completions LessonCompletion[]
  course      TrainingCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseAssignment {
  id           String         @id @default(cuid())
  courseId     String
  assigneeId   String
  assignedById String
  dueDate      DateTime?
  priority     String         @default("normal")
  notes        String?
  status       String         @default("assigned")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assignedBy   User           @relation("AssignedByCourses", fields: [assignedById], references: [id], onDelete: Cascade)
  assignee     User           @relation("AssignedCourses", fields: [assigneeId], references: [id], onDelete: Cascade)
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, assigneeId])
}

model CourseCompletion {
  id            String         @id @default(cuid())
  courseId      String
  userId        String
  completedAt   DateTime       @default(now())
  quizScore     Int?
  passed        Boolean        @default(true)
  certificateId String?        @unique
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  course        TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User           @relation("CompletedCourses", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model LessonCompletion {
  id          String         @id @default(cuid())
  lessonId    String
  userId      String
  completedAt DateTime       @default(now())
  quizScore   Int?
  timeSpent   Int?
  lesson      TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User           @relation("CompletedLessons", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
}

model DashboardData {
  id               String   @id @default(cuid())
  userId           String   @unique
  totalRevenue     Float    @default(0)
  monthlyRevenue   Float    @default(0)
  activeZones      Int      @default(0)
  systemEfficiency Float    @default(0)
  alertCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FishStock {
  id              String          @id @default(cuid())
  userId          String
  zoneId          String
  species         String
  quantity        Int
  avgWeight       Float?
  ageWeeks        Int?
  dateAdded       DateTime        @default(now())
  expectedHarvest DateTime?
  status          String          @default("growing")
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  growthLogs      FishGrowthLog[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone            Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  harvests        Harvest[]
}

model FishGrowthLog {
  id          String    @id @default(cuid())
  fishStockId String
  recordedAt  DateTime  @default(now())
  avgWeight   Float
  mortality   Int       @default(0)
  feedUsed    Float?
  notes       String?
  fishStock   FishStock @relation(fields: [fishStockId], references: [id], onDelete: Cascade)
}

model PlantCrop {
  id              String           @id @default(cuid())
  userId          String
  zoneId          String
  cropType        String
  variety         String?
  quantity        Int
  plantedDate     DateTime
  expectedHarvest DateTime?
  status          String           @default("growing")
  location        String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  harvests        Harvest[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone            Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  growthLogs      PlantGrowthLog[]
}

model PlantGrowthLog {
  id          String    @id @default(cuid())
  plantCropId String
  recordedAt  DateTime  @default(now())
  heightCm    Float?
  healthScore Int?
  losses      Int       @default(0)
  notes       String?
  plantCrop   PlantCrop @relation(fields: [plantCropId], references: [id], onDelete: Cascade)
}

model GrowthParameter {
  id             String   @id @default(cuid())
  userId         String
  type           String
  species        String
  variety        String?
  seedlingDays   Int?
  growingDays    Int
  harvestWeight  Float?
  optimalTempMin Float?
  optimalTempMax Float?
  optimalPh      Float?
  expectedYield  Float?
  yieldUnit      String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Harvest {
  id             String           @id @default(cuid())
  userId         String
  harvestDate    DateTime         @default(now())
  type           String
  fishStockId    String?
  plantCropId    String?
  quantity       Float
  unit           String
  quality        String?
  destination    String           @default("inventory")
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  fishStock      FishStock?       @relation(fields: [fishStockId], references: [id], onDelete: SetNull)
  plantCrop      PlantCrop?       @relation(fields: [plantCropId], references: [id], onDelete: SetNull)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  salesInventory SalesInventory[]
}

model SalesInventory {
  id          String     @id @default(cuid())
  userId      String
  productName String
  productType String
  quantity    Float
  unit        String
  unitPrice   Float
  harvestId   String?
  addedDate   DateTime   @default(now())
  expiryDate  DateTime?
  status      String     @default("available")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  saleItems   SaleItem[]
  harvest     Harvest?   @relation(fields: [harvestId], references: [id])
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String     @id @default(cuid())
  userId        String
  saleDate      DateTime   @default(now())
  customerName  String?
  customerEmail String?
  customerPhone String?
  subtotal      Float
  tax           Float      @default(0)
  discount      Float      @default(0)
  total         Float
  paymentMethod String?
  status        String     @default("completed")
  notes         String?
  crmCustomerId String?
  crmSynced     Boolean    @default(false)
  crmSyncedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         SaleItem[]

  @@index([userId, saleDate])
}

model SaleItem {
  id              String          @id @default(cuid())
  saleId          String
  inventoryItemId String?
  harvestId       String?
  phaseId         String?
  productName     String
  quantity        Float
  unit            String
  unitPrice       Float
  total           Float
  harvest         Harvest?        @relation(fields: [harvestId], references: [id])
  inventoryItem   SalesInventory? @relation(fields: [inventoryItemId], references: [id])
  sale            Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([phaseId])
}

model IntegrationSettings {
  id         String    @id @default(cuid())
  userId     String    @unique
  provider   String
  apiKey     String?
  locationId String?
  isEnabled  Boolean   @default(false)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  zoneId      String?
  type        String    @default("system")
  severity    String    @default("warning")
  title       String
  message     String
  status      String    @default("active")
  assigneeId  String?
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation("AlertOwner", fields: [userId], references: [id], onDelete: Cascade)
  zone        Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  assignee    Employee? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
}

model Camera {
  id             String    @id @default(cuid())
  userId         String
  name           String
  location       String?
  zoneId         String?
  connectionType String    @default("wired")
  rtspUrl        String
  protocol       String    @default("rtsp")
  brand          String?
  model          String?
  status         String    @default("offline")
  isEnabled      Boolean   @default(true)
  sortOrder      Int       @default(0)
  lastOnline     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone           Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
}

model PhaseSettings {
  id             String   @id @default(cuid())
  userId         String
  phaseId        String
  budgetMonthly  Float?
  targetRevenue  Float?
  alertsEnabled  Boolean  @default(true)
  notifications  Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phaseId])
}
