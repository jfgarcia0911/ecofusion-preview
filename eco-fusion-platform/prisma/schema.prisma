// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  role               String    @default("user") // "admin" | "manager" | "user"
  onboardingComplete Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  zones              Zone[]
  tasks              Task[]
  employees          Employee[]
  lmsProgress        UserLmsProgress[]
  dashboardData      DashboardData?
  schedules          Schedule[]        @relation("UserSchedules")
  assignedSchedules  Schedule[]        @relation("AssignedSchedules")
  scheduledTasks     ScheduledTask[]   @relation("AssignedTasks")
  createdTasks       ScheduledTask[]   @relation("CreatedTasks")
  notifications      Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User-specific zones for operations monitoring
model Zone {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // "aquaculture" | "hydroponics" | "biodigestion" | "other"
  status    String   @default("active") // "active" | "maintenance" | "offline"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics SensorReading[]
}

// Sensor readings for zones
model SensorReading {
  id          String   @id @default(cuid())
  zoneId      String
  temperature Float?
  ph          Float?
  dissolvedO2 Float?
  ammonia     Float?
  humidity    Float?
  timestamp   DateTime @default(now())

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

// User tasks (personal tasks)
model Task {
  id        String   @id @default(cuid())
  userId    String
  text      String
  completed Boolean  @default(false)
  priority  String   @default("medium") // "high" | "medium" | "low"
  dueDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// User employees (for admin management)
model Employee {
  id        String   @id @default(cuid())
  userId    String
  name      String
  role      String
  email     String
  phone     String?
  status    String   @default("Active") // "Active" | "On Leave" | "Inactive"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Weekly schedule for users (created by admin)
model Schedule {
  id          String   @id @default(cuid())
  adminId     String   // Admin who created the schedule
  assigneeId  String   // User assigned to this schedule
  title       String
  description String?
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, etc.
  startTime   String   // "09:00" format
  endTime     String   // "17:00" format
  location    String?
  recurring   Boolean  @default(true)
  color       String   @default("#00FF9D") // For calendar display
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin    User @relation("UserSchedules", fields: [adminId], references: [id], onDelete: Cascade)
  assignee User @relation("AssignedSchedules", fields: [assigneeId], references: [id], onDelete: Cascade)
}

// Scheduled tasks assigned to users (created by admin)
model ScheduledTask {
  id           String    @id @default(cuid())
  creatorId    String    // Admin who created the task
  assigneeId   String    // User assigned to this task
  title        String
  description  String?
  scheduledFor DateTime  // When the task should be done
  dueDate      DateTime  // Deadline
  priority     String    @default("medium") // "high" | "medium" | "low"
  status       String    @default("pending") // "pending" | "in_progress" | "completed" | "overdue"
  zone         String?   // Optional zone association
  notifyBefore Int       @default(30) // Minutes before to notify
  notified     Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  creator  User @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee User @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Cascade)
}

// Notifications for users
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // "info" | "warning" | "task" | "schedule"
  read      Boolean  @default(false)
  link      String?  // Optional link to related content
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// LMS progress tracking
model UserLmsProgress {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  lessonId    String?
  completed   Boolean   @default(false)
  quizScore   Int?
  xpEarned    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lessonId])
}

// User dashboard data (KPIs, revenue, etc.)
model DashboardData {
  id               String   @id @default(cuid())
  userId           String   @unique
  totalRevenue     Float    @default(0)
  monthlyRevenue   Float    @default(0)
  activeZones      Int      @default(0)
  systemEfficiency Float    @default(0)
  alertCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
