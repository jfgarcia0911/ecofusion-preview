generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                @id @default(cuid())
  name                String?
  email               String                @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  onboardingComplete  Boolean               @default(false)
  role                String                @default("user")
  /// What an EcoFusion staff account may do: see lib/staff-permissions. Empty
  /// for everyone else, and ignored for the master account, which may do all of it.
  staffPermissions    String[]              @default([])
  accounts            Account[]
  alerts              Alert[]               @relation("AlertOwner")
  cameras             Camera[]
  coursesAssignedBy   CourseAssignment[]    @relation("AssignedByCourses")
  assignedCourses     CourseAssignment[]    @relation("AssignedCourses")
  completedCourses    CourseCompletion[]    @relation("CompletedCourses")
  dashboardData       DashboardData?
  employees           Employee[]
  fishStocks          FishStock[]
  growthParameters    GrowthParameter[]
  harvests            Harvest[]
  integrationSettings IntegrationSettings[]
  completedLessons    LessonCompletion[]    @relation("CompletedLessons")
  notifications       Notification[]
  phaseSettings       PhaseSettings[]
  plantCrops          PlantCrop[]
  sales               Sale[]
  salesInventory      SalesInventory[]
  schedules           Schedule[]            @relation("UserSchedules")
  assignedSchedules   Schedule[]            @relation("AssignedSchedules")
  scheduledTasks      ScheduledTask[]       @relation("AssignedTasks")
  createdTasks        ScheduledTask[]       @relation("CreatedTasks")
  sessions            Session[]
  tasks               Task[]
  lmsProgress         UserLmsProgress[]
  zones               Zone[]
  memberships         Membership[]
  employeeRecord      Employee?             @relation("EmployeeAccount")
  staffAccess         StaffAccessLog[]      @relation("StaffAccess")
  grantedCourses      CourseGrant[]         @relation("GrantedCourses")
  coursePurchases     CoursePurchase[]      @relation("CoursePurchases")
  capturedSnapshots   Snapshot[]            @relation("CapturedSnapshots")
  activity            ActivityLog[]         @relation("MemberActivity")
  staffBusinesses     StaffBusinessAccess[] @relation("StaffBusinessAccess")
  staffAccessGranted  StaffBusinessAccess[] @relation("StaffAccessGrantedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Zone {
  id              String               @id @default(cuid())
  userId          String
  organizationId  String
  name            String
  type            String
  status          String               @default("active")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  fishStocks      FishStock[]
  plantCrops      PlantCrop[]
  metrics         SensorReading[]
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertThresholds ZoneAlertThreshold[]
  alerts          Alert[]
  cameras         Camera[]
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model SensorReading {
  id          String   @id @default(cuid())
  zoneId      String
  temperature Float?
  ph          Float?
  dissolvedO2 Float?
  ammonia     Float?
  humidity    Float?
  timestamp   DateTime @default(now())
  zone        Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, timestamp])
}

model ZoneAlertThreshold {
  id         String   @id @default(cuid())
  zoneId     String
  parameter  String
  minValue   Float?
  maxValue   Float?
  enabled    Boolean  @default(true)
  alertLevel String   @default("warning")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  zone       Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, parameter])
}

model Task {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  text           String
  completed      Boolean      @default(false)
  priority       String       @default("medium")
  dueDate        DateTime?
  phaseId        String?
  assignee       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Employee {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  name           String
  role           String
  email          String
  phone          String?
  status         String       @default("Active")
  /// The login this person uses, when they have one. Distinct from userId,
  /// which records who entered the row.
  accountId      String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        User?        @relation("EmployeeAccount", fields: [accountId], references: [id], onDelete: SetNull)
  alerts         Alert[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Schedule {
  id          String   @id @default(cuid())
  adminId     String
  assigneeId  String
  title       String
  description String?
  dayOfWeek   Int
  startTime   String
  endTime     String
  location    String?
  recurring   Boolean  @default(true)
  color       String   @default("#00FF9D")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       User     @relation("UserSchedules", fields: [adminId], references: [id], onDelete: Cascade)
  assignee    User     @relation("AssignedSchedules", fields: [assigneeId], references: [id], onDelete: Cascade)
}

model ScheduledTask {
  id           String    @id @default(cuid())
  creatorId    String
  assigneeId   String
  title        String
  description  String?
  scheduledFor DateTime
  dueDate      DateTime
  priority     String    @default("medium")
  status       String    @default("pending")
  zone         String?
  notifyBefore Int       @default(30)
  notified     Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignee     User      @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator      User      @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLmsProgress {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  lessonId    String?
  completed   Boolean   @default(false)
  quizScore   Int?
  xpEarned    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lessonId])
}

/// A course, written either by EcoFusion or by a farm for its own people.
///
/// `organizationId` says which: null is EcoFusion's, and reaches a farm only
/// once it has been loaded into it. A farm's own course belongs to that farm
/// and is visible nowhere else. Nobody edits a course they do not own, which
/// is what keeps one farm's manager out of the curriculum every other farm is
/// working through.
model TrainingCourse {
  id             String               @id @default(cuid())
  code           String
  title          String
  description    String
  category       String
  duration       Int
  isRequired     Boolean              @default(false)
  renewalDays    Int?
  passScore      Int                  @default(80)
  isActive       Boolean              @default(true)
  sortOrder      Int                  @default(0)
  /// What a business pays, once, to carry this course, in the smallest unit of
  /// the shop's currency. Null means not on sale yet; 0 means free. Only ever
  /// set on EcoFusion's courses - a business's own course is not for sale.
  priceCents     Int?
  organizationId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  purchaseItems  CoursePurchaseItem[]
  assignments    CourseAssignment[]
  completions    CourseCompletion[]
  lessons        TrainingLesson[]
  materials      CourseMaterial[]
  grants         CourseGrant[]
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// What a course hands its learners besides the lessons themselves: handouts,
/// cheatsheets, a glossary, assignment briefs, the syllabus.
///
/// Kept apart from TrainingLesson on purpose. A lesson is a step on the path,
/// and finishing the course means finishing every one of them; a handout is
/// something to keep open beside the path. Filing handouts as lessons would
/// make a learner click through a glossary to earn a certificate.
///
/// Nothing written for instructors lands here. Answer keys and instructor
/// notes are cut out on import, and grading summaries are never imported.
model CourseMaterial {
  id        String         @id @default(cuid())
  courseId  String
  /// syllabus | handout | cheatsheet | reference | activity | assignment
  kind      String
  title     String
  content   String
  sortOrder Int            @default(0)
  /// The file it came from, relative to education/courses. What a re-import
  /// matches on, so running the importer again updates rather than duplicates.
  sourceKey String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  course    TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, sourceKey])
  @@index([courseId])
}

/// One of EcoFusion's courses, held by one business.
///
/// Holding is a grant, not a copy. There is only ever one course, so a
/// correction reaches every business holding it at once, and no business can
/// edit what it holds. A business sees what it holds plus what it wrote
/// itself, and nothing else.
///
/// A business comes to hold a course by buying it, by taking one that is free,
/// or by being given it by the master account.
model CourseGrant {
  id             String   @id @default(cuid())
  courseId       String
  organizationId String
  /// purchase | free | gift
  source         String   @default("gift")
  /// The purchase that paid for it, when it was bought. A full refund takes
  /// the course away again by this link.
  purchaseId     String?
  /// Who unlocked it: the buyer, or the master account that gave it. Kept
  /// when that account is deleted, because the grant outlives whoever made it.
  grantedById    String?
  createdAt      DateTime @default(now())

  course       TrainingCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedBy    User?           @relation("GrantedCourses", fields: [grantedById], references: [id], onDelete: SetNull)
  purchase     CoursePurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@unique([courseId, organizationId])
  @@index([organizationId])
}

/// What each business was carrying when courses became something bought.
///
/// A copy of CourseGrant as it stood, kept so that decision can be undone. The
/// app neither reads nor writes it; it is here so the schema describes the
/// database as it is, and a later migration does not mistake it for drift.
model CourseGrantRetired {
  id             String   @id
  courseId       String
  organizationId String
  grantedById    String?
  createdAt      DateTime
  retiredAt      DateTime @default(now())
}

/// Every course in one level, sold together at one price.
///
/// Keyed by the level's name, which is what TrainingCourse.category holds. A
/// level with no row has no package. Buying one unlocks every active course in
/// the level at that moment; one added to the level later is not included.
model CoursePackage {
  category   String   @id
  priceCents Int
  updatedAt  DateTime @updatedAt
}

/// A business paying for courses, one Stripe checkout at a time.
///
/// Written before the customer is sent to Stripe, as pending, so there is a
/// record of what was on offer and at what price even if they never come back.
/// Only a confirmed payment moves it to paid and unlocks the courses; nothing
/// the browser says can.
model CoursePurchase {
  id                    String    @id @default(cuid())
  organizationId        String
  /// The owner who bought. Kept when that account is deleted.
  purchasedById         String?
  /// pending | paid | refunded | expired
  status                String    @default("pending")
  amountCents           Int
  currency              String
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?   @unique
  createdAt             DateTime  @default(now())
  paidAt                DateTime?
  refundedAt            DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchasedBy  User?                @relation("CoursePurchases", fields: [purchasedById], references: [id], onDelete: SetNull)
  items        CoursePurchaseItem[]
  grants       CourseGrant[]

  @@index([organizationId, createdAt])
}

/// One course in a purchase, at the price it was sold for.
///
/// The code and title are copied rather than only referenced, so the record of
/// what somebody paid for still reads correctly after the course is renamed or
/// removed.
model CoursePurchaseItem {
  id              String  @id @default(cuid())
  purchaseId      String
  courseId        String?
  courseCode      String
  courseTitle     String
  priceCents      Int
  /// The level whose package this course was bought in, or null when it was
  /// bought on its own. A package's price is shared across its courses here so
  /// the items still add up to what was paid.
  packageCategory String?

  purchase CoursePurchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  course   TrainingCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([courseId])
}

model TrainingLesson {
  id          String             @id @default(cuid())
  courseId    String
  title       String
  description String?
  type        String             @default("text")
  content     String?
  duration    Int
  sortOrder   Int                @default(0)
  /// For a quiz: [{ id, question, options[], correctAnswer, explanation? }].
  /// The answers never leave the server - the course API strips them, and the
  /// quiz is graded where they are.
  questions   Json?
  /// Which part of the written curriculum this lesson is - "module:03",
  /// "quiz:03", "final" - so the importer can find it again. Null for a
  /// lesson a business wrote itself. Identity lives here rather than in
  /// sortOrder, which only says where a lesson sits and has to be free to move
  /// when a quiz is slotted in behind a module.
  sourceKey   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  completions LessonCompletion[]
  course      TrainingCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, sourceKey])
}

model CourseAssignment {
  id           String         @id @default(cuid())
  courseId     String
  assigneeId   String
  assignedById String
  dueDate      DateTime?
  priority     String         @default("normal")
  notes        String?
  status       String         @default("assigned")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assignedBy   User           @relation("AssignedByCourses", fields: [assignedById], references: [id], onDelete: Cascade)
  assignee     User           @relation("AssignedCourses", fields: [assigneeId], references: [id], onDelete: Cascade)
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, assigneeId])
}

model CourseCompletion {
  id            String         @id @default(cuid())
  courseId      String
  userId        String
  completedAt   DateTime       @default(now())
  quizScore     Int?
  passed        Boolean        @default(true)
  certificateId String?        @unique
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  course        TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User           @relation("CompletedCourses", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model LessonCompletion {
  id          String         @id @default(cuid())
  lessonId    String
  userId      String
  completedAt DateTime       @default(now())
  quizScore   Int?
  timeSpent   Int?
  lesson      TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User           @relation("CompletedLessons", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
}

model DashboardData {
  id               String       @id @default(cuid())
  userId           String       @unique
  organizationId   String
  totalRevenue     Float        @default(0)
  monthlyRevenue   Float        @default(0)
  activeZones      Int          @default(0)
  systemEfficiency Float        @default(0)
  alertCount       Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model FishStock {
  id              String          @id @default(cuid())
  userId          String
  organizationId  String
  zoneId          String
  species         String
  quantity        Int
  avgWeight       Float?
  ageWeeks        Int?
  dateAdded       DateTime        @default(now())
  expectedHarvest DateTime?
  status          String          @default("growing")
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  growthLogs      FishGrowthLog[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone            Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  harvests        Harvest[]
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model FishGrowthLog {
  id          String    @id @default(cuid())
  fishStockId String
  recordedAt  DateTime  @default(now())
  avgWeight   Float
  mortality   Int       @default(0)
  feedUsed    Float?
  notes       String?
  fishStock   FishStock @relation(fields: [fishStockId], references: [id], onDelete: Cascade)
}

model PlantCrop {
  id              String           @id @default(cuid())
  userId          String
  organizationId  String
  zoneId          String
  cropType        String
  variety         String?
  quantity        Int
  plantedDate     DateTime
  expectedHarvest DateTime?
  status          String           @default("growing")
  location        String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  harvests        Harvest[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone            Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  growthLogs      PlantGrowthLog[]
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model PlantGrowthLog {
  id          String    @id @default(cuid())
  plantCropId String
  recordedAt  DateTime  @default(now())
  heightCm    Float?
  healthScore Int?
  losses      Int       @default(0)
  notes       String?
  plantCrop   PlantCrop @relation(fields: [plantCropId], references: [id], onDelete: Cascade)
}

model GrowthParameter {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  type           String
  species        String
  variety        String?
  seedlingDays   Int?
  growingDays    Int
  harvestWeight  Float?
  optimalTempMin Float?
  optimalTempMax Float?
  optimalPh      Float?
  expectedYield  Float?
  yieldUnit      String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Harvest {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  harvestDate    DateTime         @default(now())
  type           String
  fishStockId    String?
  plantCropId    String?
  quantity       Float
  unit           String
  quality        String?
  destination    String           @default("inventory")
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  fishStock      FishStock?       @relation(fields: [fishStockId], references: [id], onDelete: SetNull)
  plantCrop      PlantCrop?       @relation(fields: [plantCropId], references: [id], onDelete: SetNull)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  salesInventory SalesInventory[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model SalesInventory {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  productName    String
  productType    String
  quantity       Float
  unit           String
  unitPrice      Float
  harvestId      String?
  addedDate      DateTime     @default(now())
  expiryDate     DateTime?
  status         String       @default("available")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  saleItems      SaleItem[]
  harvest        Harvest?     @relation(fields: [harvestId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Sale {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  saleDate       DateTime     @default(now())
  customerName   String?
  customerEmail  String?
  customerPhone  String?
  subtotal       Float
  tax            Float        @default(0)
  discount       Float        @default(0)
  total          Float
  paymentMethod  String?
  status         String       @default("completed")
  notes          String?
  crmCustomerId  String?
  crmSynced      Boolean      @default(false)
  crmSyncedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          SaleItem[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, saleDate])
  @@index([organizationId])
}

model SaleItem {
  id              String          @id @default(cuid())
  saleId          String
  inventoryItemId String?
  harvestId       String?
  phaseId         String?
  productName     String
  quantity        Float
  unit            String
  unitPrice       Float
  total           Float
  harvest         Harvest?        @relation(fields: [harvestId], references: [id])
  inventoryItem   SalesInventory? @relation(fields: [inventoryItemId], references: [id])
  sale            Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([phaseId])
}

model IntegrationSettings {
  id             String       @id @default(cuid())
  userId         String
  organizationId String       @unique
  provider       String
  apiKey         String?
  locationId     String?
  isEnabled      Boolean      @default(false)
  lastSyncAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Alert {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  zoneId         String?
  type           String    @default("system")
  severity       String    @default("warning")
  title          String
  message        String
  status         String    @default("active")
  assigneeId     String?
  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation("AlertOwner", fields: [userId], references: [id], onDelete: Cascade)
  zone         Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  assignee     Employee?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Camera {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  name           String
  location       String?
  zoneId         String?
  connectionType String    @default("wired")
  rtspUrl        String
  protocol       String    @default("rtsp")
  brand          String?
  model          String?
  status         String    @default("offline")
  isEnabled      Boolean   @default(true)
  sortOrder      Int       @default(0)
  lastOnline     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone         Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model PhaseSettings {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  phaseId        String
  budgetMonthly  Float?
  targetRevenue  Float?
  alertsEnabled  Boolean  @default(true)
  notifications  Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phaseId])
  @@index([organizationId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Where the business is, written the way somebody would say it out loud:
  /// "701 Whitelock St, Baltimore, MD". Free text and optional, because it
  /// exists to tell two businesses of similar name apart in a list, not to be
  /// posted to. Nothing routes, bills or reports on it.
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Access is granted to the organization, never to the individual. When a
  /// farm's trial lapses or its subscription is cancelled, every member loses
  /// access at once, including accounts the owner created.
  plan                 String    @default("trial")
  /// trialing | active | past_due | canceled
  subscriptionStatus   String    @default("trialing")
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  /// One Stripe customer per farm, reused across renewals.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique

  /// The business whose subscription pays for this one.
  ///
  /// An owner may run several businesses from one login. The first is the
  /// billing account and the rest point at it, so one subscription covers them
  /// all and adding a site is not a way to collect another free trial. Null
  /// means the business bills for itself, which every business created by
  /// signup or by staff does.
  billingParentId  String?
  billingParent    Organization?  @relation("BillingChildren", fields: [billingParentId], references: [id], onDelete: SetNull)
  billedBusinesses Organization[] @relation("BillingChildren")

  memberships         Membership[]
  businessUnits       BusinessUnit[]
  zones               Zone[]
  tasks               Task[]
  employees           Employee[]
  dashboardData       DashboardData[]
  fishStocks          FishStock[]
  plantCrops          PlantCrop[]
  growthParameters    GrowthParameter[]
  harvests            Harvest[]
  salesInventory      SalesInventory[]
  sales               Sale[]
  integrationSettings IntegrationSettings?
  alerts              Alert[]
  cameras             Camera[]
  phaseSettings       PhaseSettings[]
  staffAccess         StaffAccessLog[]
  activity            ActivityLog[]
  staffBusinessAccess StaffBusinessAccess[]
  trainingCourses     TrainingCourse[]
  courseGrants        CourseGrant[]
  coursePurchases     CoursePurchase[]
  snapshotsTakenFrom  Snapshot[]            @relation("SnapshotSource")

  @@index([billingParentId])
}

/// A configured farm, captured so others can be started from it.
///
/// A farm set up well is the best description of how a farm should be set up,
/// so a snapshot is taken from a real one rather than written by hand. What it
/// holds is configuration - units, zones, thresholds, growing parameters, which
/// classes to carry - and never a record of anything that happened: no stock,
/// no sales, no readings, nobody's training history.
///
/// The capture is a copy, not a link. A farm started from a snapshot owns what
/// it was given and may change it freely, which is the opposite of how a course
/// grant works, and deliberately so: a starting point is meant to be departed
/// from.
model Snapshot {
  id             String   @id @default(cuid())
  name           String
  description    String?
  /// Applied to every farm created from here on. At most one is marked.
  isDefault      Boolean  @default(false)
  /// The shape of `payload`. Read before applying, so a snapshot taken today
  /// still says something intelligible after the models it describes move on.
  version        Int      @default(1)
  payload        Json
  capturedFromId String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  capturedFrom Organization? @relation("SnapshotSource", fields: [capturedFromId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("CapturedSnapshots", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isDefault])
}

/// Every time EcoFusion staff work inside a customer's farm.
///
/// Staff reach farms they are not members of, so the organization scoping that
/// accounts for everyone else cannot account for them. Entering a farm is
/// written here, as is each change made while inside one, and the app never
/// deletes from this table.
/// What a business's own people did in it.
///
/// Separate from StaffAccessLog, which records EcoFusion visiting somebody
/// else's business and is a different kind of fact. This one is the business's
/// own record of itself: who signed in, and who changed what.
///
/// Written by the platform and never edited or deleted by it. A record its
/// subject could revise would not be worth showing them.
model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  /// signin | write
  action         String
  /// Method and path of the request, for a write. Null for a sign-in.
  method         String?
  path           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Kept when the account goes, so the record does not quietly lose entries.
  user         User?        @relation("MemberActivity", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

/// Which businesses a member of EcoFusion staff may work in.
///
/// The platform owner reaches every business because the platform is theirs.
/// Staff are their assistants and reach only what they are handed, one business
/// at a time, so a person hired to look after three customers cannot open the
/// other forty.
///
/// Distinct from Membership, which is a customer's own person inside their own
/// business. Nobody here is employed by the business they can open.
model StaffBusinessAccess {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  /// The platform owner who handed it over. Kept when that account goes.
  grantedById    String?
  createdAt      DateTime @default(now())

  user         User         @relation("StaffBusinessAccess", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("StaffAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model StaffAccessLog {
  id             String   @id @default(cuid())
  staffUserId    String
  /// The business it happened in. Null for a change to the platform itself,
  /// such as taking on staff or editing a snapshot, which belongs to no one
  /// business but is still a change somebody made.
  organizationId String?
  /// enter | leave | write
  action         String
  /// Method and path of the request, for a write. Null for enter and leave.
  method         String?
  path           String?
  /// What the change said, in words, with every secret blanked out.
  detail         String?
  createdAt      DateTime @default(now())

  staffUser    User          @relation("StaffAccess", fields: [staffUserId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([staffUserId, createdAt])
}

/// A user's role is held per organization, not on the user record, so the same
/// person can be an owner of one farm and a member of another.
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("member")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// The silos a farm runs. Seeded from EcoFusion's seven, editable per farm:
/// another operation may run only aquaculture, or add units of its own.
model BusinessUnit {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  title          String
  description    String
  icon           String   @default("Layers")
  color          String   @default("from-emerald-400 to-emerald-600")
  accent         String   @default("text-emerald-400")
  keywords       String[]
  sortOrder      Int      @default(0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}
