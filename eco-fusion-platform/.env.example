# Supabase Database
# Get these from your Supabase project: Settings > Database > Connection string
# Use the "Transaction" connection string (port 6543) for DATABASE_URL (pooled connections)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use the "Session" connection string (port 5432) for DIRECT_URL (migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth.js (next-auth v5). AUTH_SECRET is the current name; NEXTAUTH_SECRET is
# still read for backward compatibility. Set both to the same value.
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="" # Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="" # Same value as AUTH_SECRET

# Google OAuth (optional - for Google sign-in)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Gemini API (AI features: insights, alert analysis)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Encryption key for stored integration credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# GoHighLevel webhook signature verification (optional - only if using the integration)
GOHIGHLEVEL_WEBHOOK_SECRET=""

# Billing (Stripe). Test keys start sk_test_ / whsec_ and charge nothing.
# STRIPE_PRICE_ID is the recurring price the subscription is created from.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# One recurring price per plan. STRIPE_PRICE_ID stands in for Starter if STRIPE_PRICE_STARTER is unset.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
# pk_test_... / pk_live_... Lets checkout open inside EcoFusion instead of on Stripe's page.
STRIPE_PUBLISHABLE_KEY=""
# ca_... from Stripe Connect settings. Lets an agency connect the Stripe account
# it already has by signing in, instead of creating a new one.
STRIPE_CONNECT_CLIENT_ID=""
# Signing secret of the webhook for events on connected accounts.
STRIPE_CONNECT_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_SECRET=
# Origin Stripe returns the customer to after checkout.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate limiting (Upstash Redis, free tier is plenty)
# Without these, limits are counted per serverless instance and reset on every
# deploy - which means the sign-in limit does not actually hold. Create a
# database at https://console.upstash.com and copy its REST url and token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email (Resend), for password reset links
# Without these the "Forgot password" page tells people to ask their owner or
# support instead. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="EcoFusion <no-reply@example.com>"

# Only behind Cloudflare: trust its client-address header for rate limiting.
# TRUST_CLOUDFLARE="1"
